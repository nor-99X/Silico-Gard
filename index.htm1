<!DOCTYPE html>

<html lang="en">

<head>

<meta charset="UTF-8">

<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Silico Guard | Fire Safety Innovation</title>

<style>

*{box-sizing:border-box;margin:0;padding:0}

body{

font-family:Arial,sans-serif;

background:#f4f6f7;

color:#263238;

line-height:1.6

}

nav{

background:#172026;

padding:20px 7%;

display:flex;

justify-content:space-between;

align-items:center;

color:white

}

.logo{

font-size:20px;

font-weight:bold

}

.logo span{

color:#e87522

}

nav a{

color:#ddd;

text-decoration:none;

margin-left:25px;

font-size:14px

}

.hero{

background:linear-gradient(120deg,#172026,#29363d);

color:white;

padding:110px 8%;

min-height:560px;

display:flex;

align-items:center

}

.hero-content{

max-width:850px

}

.tag{

color:#f39a4a;

font-size:13px;

font-weight:bold;

letter-spacing:2px;

margin-bottom:20px

}

h1{

font-size:80px;

line-height:1;

margin-bottom:25px

}

h1 span{

color:#f39a4a

}

.hero p{

font-size:21px;

color:#d9e0e3;

max-width:700px;

margin-bottom:35px

}

.btn{

display:inline-block;

padding:14px 23px;

border-radius:6px;

text-decoration:none;

font-weight:bold;

margin-right:10px;

margin-bottom:10px

}

.primary{

background:#e87522;

color:white

}

.secondary{

border:1px solid #89959b;

color:white

}

.stats{

width:86%;

margin:-45px auto 0;

position:relative;

background:white;

display:grid;

grid-template-columns:repeat(4,1fr);

box-shadow:0 15px 35px #00000012;

border-radius:10px;

overflow:hidden

}

.stat{

padding:28px;

text-align:center;

border-right:1px solid #e5e8ea

}

.stat:last-child{

border:0

}

.stat strong{

display:block;

font-size:28px;

color:#172026

}

.stat span{

font-size:13px;

color:#69757c

}

section{

padding:90px 8%

}

.title{

max-width:700px;

margin-bottom:45px

}

.label{

color:#e87522;

font-size:12px;

font-weight:bold;

letter-spacing:2px;

margin-bottom:10px

}

.title h2{

font-size:42px;

color:#172026;

margin-bottom:15px

}

.title p{

color:#69757c

}

.cards{

display:grid;

grid-template-columns:repeat(2,1fr);

gap:25px

}

.card{

background:white;

padding:35px;

border-radius:10px;

border:1px solid #e1e6e8;

border-top:6px solid #e87522;

box-shadow:0 8px 25px #00000008

}

.card h3{

font-size:25px;

margin:10px 0 15px;

color:#172026

}

.card p{

color:#69757c

}

.development{

background:white

}

.steps{

display:grid;

grid-template-columns:repeat(3,1fr);

gap:22px

}

.step{

background:#f4f6f7;

padding:30px;

border-left:4px solid #e87522

}

.step-number{

font-size:35px;

font-weight:bold;

color:#d7dcdf

}

.step h3{

margin:8px 0

}

.files{

display:grid;

grid-template-columns:repeat(3,1fr);

gap:22px

}

.file{

background:#172026;

color:white;

padding:30px;

border-radius:10px;

text-decoration:none;

min-height:190px

}

.file-icon{

font-size:30px;

margin-bottom:20px

}

.file h3{

margin-bottom:8px

}

.file p{

color:#bcc5c9;

font-size:14px

}

.file strong{

display:block;

color:#f39a4a;

margin-top:20px;

font-size:13px

}

.safety{

background:#fff6ee

}

.safety-box{

background:white;

border-left:5px solid #e87522;

padding:30px;

max-width:950px;

box-shadow:0 5px 20px #00000008

}

.award{

background:#172026;

color:white;

text-align:center

}

.award h2{

font-size:42px;

margin-bottom:15px

}

.award p{

color:#c5cdd1;

max-width:650px;

margin:auto

}

.badge{

display:inline-block;

margin-top:30px;

padding:15px 25px;

border:1px solid #66747b;

border-radius:7px;

color:#f39a4a;

font-weight:bold

}

.about{

display:grid;

grid-template-columns:1fr 1fr;

gap:50px;

align-items:center

}

.about-box{

background:#172026;

color:white;

padding:40px;

border-radius:10px

}

.about-box p{

color:#c7d0d4

}

.tags{

display:flex;

flex-wrap:wrap;

gap:8px;

margin-top:25px

}

.tags span{

background:#303d44;

padding:7px 10px;

border-radius:5px;

font-size:12px

}

footer{

background:#10181d;

color:#9da8ad;

padding:30px 8%;

display:flex;

justify-content:space-between

}

footer a{

color:#f39a4a;

text-decoration:none

}

@media(max-width:800px){

nav a{

display:none

}

.hero{

padding:80px 7%

}

h1{

font-size:58px

}

.stats{

grid-template-columns:repeat(2,1fr)

}

.stat{

border-bottom:1px solid #e5e8ea

}

.cards,

.steps,

.files,

.about{

grid-template-columns:1fr

}

section{

padding:70px 7%

}

.title h2,

.award h2{

font-size:34px

}

footer{

flex-direction:column;

gap:10px

}

}

</style>

</head>

